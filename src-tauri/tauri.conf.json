{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quake Companion",
  "version": "0.1.0",
  "identifier": "com.decokee.quakecompanion",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Quake Companion",
        "fullscreen": false,
        "decorations": false,
        "resizable": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "shadow": false,
        "width": 1920,
        "height": 480,
        "minWidth": 1920,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}